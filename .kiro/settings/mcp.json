{
  "mcpServers": {
    "labkit-ping": {
      "command": "node",
      "args": [
        "labkit/mcp/ping.mjs"
      ],
      "env": {},
      "disabled": false,
      "autoApprove": [
        "ping"
      ]
    },
    "labkit-atlassian": {
      "command": "node",
      "args": [
        "labkit/mcp/atlassian.mjs"
      ],
      "env": {},
      "disabled": false,
      "autoApprove": [
        "getAccessibleAtlassianResources",
        "atlassianUserInfo",
        "lookupJiraAccountId",
        "getVisibleJiraProjects",
        "searchJiraIssuesUsingJql",
        "getJiraIssue",
        "getTransitionsForJiraIssue",
        "getConfluenceSpaces",
        "getPagesInConfluenceSpace",
        "searchConfluenceUsingCql",
        "getConfluencePage"
      ]
    },
    "labkit-grafana": {
      "command": "node",
      "args": [
        "labkit/mcp/grafana.mjs"
      ],
      "env": {},
      "disabled": false,
      "autoApprove": [
        "list_datasources",
        "query_loki_logs",
        "list_loki_label_names",
        "list_loki_label_values",
        "list_prometheus_metric_names",
        "query_prometheus"
      ]
    },
    "labkit-db": {
      "command": "node",
      "args": [
        "labkit/mcp/db.mjs"
      ],
      "env": {},
      "disabled": false,
      "autoApprove": [
        "list_tables",
        "describe_table"
      ]
    },
    "playwright": {
      "command": "npx",
      "args": [
        "-y",
        "@playwright/mcp@latest",
        "--browser",
        "chrome"
      ],
      "env": {},
      "disabled": true,
      "autoApprove": []
    }
  }
}
