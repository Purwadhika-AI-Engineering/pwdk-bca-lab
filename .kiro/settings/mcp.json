{
  "mcpServers": {
    "labkit-ping": {
      "command": "node",
      "args": [
        "labkit/mcp/ping.mjs"
      ],
      "env": {},
      "disabled": false,
      "autoApprove": [
        "ping"
      ]
    },
    "labkit-atlassian": {
      "command": "node",
      "args": [
        "labkit/mcp/atlassian.mjs"
      ],
      "env": {},
      "disabled": false,
      "autoApprove": [
        "getAccessibleAtlassianResources",
        "atlassianUserInfo",
        "lookupJiraAccountId",
        "getVisibleJiraProjects",
        "searchJiraIssuesUsingJql",
        "getJiraIssue",
        "getTransitionsForJiraIssue",
        "getConfluenceSpaces",
        "getPagesInConfluenceSpace",
        "searchConfluenceUsingCql",
        "getConfluencePage"
      ]
    }
  }
}
